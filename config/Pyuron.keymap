#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define MOUSE 6

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

/ {
    combos {
        compatible = "zmk,combos";

        l0_esc {
            bindings = <&kp ESCAPE>;
            key-positions = <0 1>;
            timeout-ms = <20>;
            require-prior-idle-ms = <10>;
            layers = <0>;
        };

        l0_sq {
            bindings = <&kp SINGLE_QUOTE>;
            key-positions = <5 15>;
            timeout-ms = <20>;
            require-prior-idle-ms = <10>;
            layers = <0>;
        };

        l0_dq {
            bindings = <&kp DOUBLE_QUOTES>;
            key-positions = <15 27>;
            timeout-ms = <20>;
            require-prior-idle-ms = <10>;
            layers = <0>;
        };

        l0_colon {
            bindings = <&kp COLON>;
            key-positions = <6 16>;
            timeout-ms = <20>;
            require-prior-idle-ms = <10>;
            layers = <0>;
        };

        l0_semicolon {
            bindings = <&kp SEMICOLON>;
            key-positions = <16 28>;
            timeout-ms = <20>;
            require-prior-idle-ms = <10>;
            layers = <0>;
        };

        l0_eq {
            bindings = <&kp EQUAL>;
            key-positions = <7 17>;
            timeout-ms = <20>;
            require-prior-idle-ms = <10>;
            layers = <0>;
        };

        l0_ex {
            bindings = <&kp EXCLAMATION>;
            key-positions = <17 29>;
            timeout-ms = <20>;
            require-prior-idle-ms = <10>;
            layers = <0>;
        };

        l0_pipe {
            bindings = <&kp PIPE>;
            key-positions = <8 18>;
            timeout-ms = <20>;
            require-prior-idle-ms = <10>;
            layers = <0>;
        };

        l0_and {
            bindings = <&kp AMPERSAND>;
            key-positions = <18 30>;
            timeout-ms = <20>;
            layers = <0>;
            require-prior-idle-ms = <10>;
        };

        l0_bsl {
            bindings = <&kp BACKSLASH>;
            key-positions = <18 16>;
            timeout-ms = <20>;
            require-prior-idle-ms = <10>;
            layers = <0>;
        };

        l0_min {
            bindings = <&kp MINUS>;
            key-positions = <1 11>;
            timeout-ms = <20>;
            require-prior-idle-ms = <10>;
            layers = <0>;
        };

        l0_plus {
            bindings = <&kp PLUS>;
            key-positions = <21 11>;
            timeout-ms = <20>;
            require-prior-idle-ms = <10>;
            layers = <0>;
        };

        l0_hsh {
            bindings = <&kp HASH>;
            key-positions = <2 12>;
            timeout-ms = <20>;
            require-prior-idle-ms = <10>;
            layers = <0>;
        };

        l0_astrk {
            bindings = <&kp ASTERISK>;
            key-positions = <12 22>;
            timeout-ms = <20>;
            require-prior-idle-ms = <10>;
            layers = <0>;
        };

        l0_doll {
            bindings = <&kp DOLLAR>;
            key-positions = <3 13>;
            timeout-ms = <20>;
            require-prior-idle-ms = <10>;
            layers = <0>;
        };

        l0_pc {
            bindings = <&kp PRCNT>;
            key-positions = <13 23>;
            timeout-ms = <20>;
            require-prior-idle-ms = <10>;
            layers = <0>;
        };

        l0_caret {
            bindings = <&kp CARET>;
            key-positions = <4 14>;
            timeout-ms = <20>;
            require-prior-idle-ms = <10>;
            layers = <0>;
        };

        l0_lp {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <1 2>;
            timeout-ms = <20>;
            require-prior-idle-ms = <10>;
            layers = <0>;
        };

        l0_rp {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <2 3>;
            timeout-ms = <20>;
            require-prior-idle-ms = <10>;
            layers = <0>;
        };

        l0_lbt {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <11 12>;
            timeout-ms = <20>;
            require-prior-idle-ms = <10>;
            layers = <0>;
        };

        l0_rbt {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <12 13>;
            timeout-ms = <20>;
            require-prior-idle-ms = <10>;
            layers = <0>;
        };

        l0_lbe {
            bindings = <&kp LEFT_BRACE>;
            key-positions = <21 22>;
            timeout-ms = <20>;
            require-prior-idle-ms = <10>;
            layers = <0>;
        };

        l0_rbe {
            bindings = <&kp RIGHT_BRACE>;
            key-positions = <22 23>;
            timeout-ms = <20>;
            require-prior-idle-ms = <10>;
            layers = <0>;
        };

        l0_gve {
            bindings = <&kp GRAVE>;
            key-positions = <6 8>;
            timeout-ms = <20>;
            require-prior-idle-ms = <10>;
            layers = <0>;
        };

        l0_tab {
            bindings = <&kp TAB>;
            key-positions = <0 2>;
            timeout-ms = <20>;
            require-prior-idle-ms = <10>;
            layers = <0>;
        };
    };

    my_lt: my_lt {
        compatible = "zmk,behavior-hold-tap";
        label = "MY_LT";
        bindings = <&mo>, <&kp>;

        #binding-cells = <2>;
        tapping-term-ms = <300>;
        require-prior-idle-ms = <200>;
        flavor = "tap-preferred";
    };

    my_mt: my_mt {
        compatible = "zmk,behavior-hold-tap";
        label = "MY_MT";
        bindings = <&kp>, <&kp>;

        #binding-cells = <2>;
        tapping-term-ms = <300>;
        require-prior-idle-ms = <200>;
        flavor = "tap-preferred";
    };
};

/ {
    behaviors {
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&kp Q                  &kp W                     &kp E         &kp R         &kp T           &kp Y  &kp U  &kp I          &kp O  &kp P
&my_mt LEFT_CONTROL A  &kp S                     &kp D         &kp F         &kp G           &kp H  &kp J  &kp K          &kp L  &kp RET
&my_mt LEFT_SHIFT Z    &kp X                     &kp C         &kp V         &my_lt 3 B      &none  &none  &kp N          &kp M  &kp COMMA
&kp DOT                &my_mt RIGHT_SHIFT SLASH  &kp LEFT_ALT  &kp LEFT_GUI  &my_lt 1 SPACE  &none  &none  &kp BACKSPACE  &to 2  &kp RIGHT_CONTROL
            >;
        };

        layer_1 {
            bindings = <
&kp N1     &kp N2     &kp N3         &kp N4      &kp N5  &kp N6     &kp N7     &kp N8      &kp N9    &kp N0
&kp LCTRL  &kp CAPS   &kp LA(GRAVE)  &kp INSERT  &none   &kp MINUS  &kp EQUAL  &kp LBKT    &kp RBKT  &kp ENTER
&kp LSHFT  &none      &none          &none       &none   &none      &none      &kp GRAVE   &kp SEMI  &kp APOS
&kp BSLH   &kp RSHFT  &kp LALT       &kp LGUI    &trans  &none      &none      &kp DELETE  &none     &kp RCTRL
            >;
        };

        layer_2 {
            bindings = <
&kp F1     &kp F2           &kp F3          &kp F4       &kp F5         &kp F6          &kp F7          &kp F8        &kp F9           &kp F10
&kp LCTRL  &kp F11          &kp F12         &kp HOME     &kp END        &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT_ARROW  &kp ENTER
&kp LSHFT  &kp PRINTSCREEN  &kp SCROLLLOCK  &kp PAGE_UP  &kp PAGE_DOWN  &none           &none           &mkp MB4      &mkp MB3         &mkp MB2
&mkp MB5   &kp RSHFT        &kp LALT        &kp LGUI     &kp LC(A)      &none           &none           &mkp MB1      &to 0            &kp RCTRL
            >;
        };

        layer_3 {
            bindings = <
&kp C_MUTE        &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3    &bt BT_SEL 4
&kp C_STOP_EJECT  &kp PAUSE_BREAK    &kp C_PREVIOUS   &kp C_PP              &kp C_NEXT            &none         &none         &none         &none           &none
&none             &none              &none            &none                 &trans                &none         &none         &bootloader   &studio_unlock  &none
&bt BT_CLR_ALL    &bt BT_CLR         &none            &none                 &none                 &none         &none         &none         &none           &none
            >;
        };
    };
};
