#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define MOUSE 6

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

/ {
    combos { compatible = "zmk,combos"; };

    my_lt: my_lt {
        compatible = "zmk,behavior-hold-tap";
        label = "MY_LT";
        bindings = <&mo>, <&kp>;

        #binding-cells = <2>;
        tapping-term-ms = <400>;
        require-prior-idle-ms = <300>;
        flavor = "tap-preferred";
    };

    my_mt: my_mt {
        compatible = "zmk,behavior-hold-tap";
        label = "MY_MT";
        bindings = <&kp>, <&kp>;

        #binding-cells = <2>;
        tapping-term-ms = <400>;
        require-prior-idle-ms = <300>;
        flavor = "tap-preferred";
    };
};

/ {
    behaviors {
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&kp Q                  &kp W                     &kp E     &kp R     &kp T           &kp Y    &kp U          &kp I           &kp O  &kp P
&my_mt LEFT_CONTROL A  &kp S                     &kp D     &kp F     &kp G           &kp H    &kp J          &kp K           &kp L  &kp RET
&my_mt LEFT_SHIFT Z    &kp X                     &kp C     &kp V     &kp B           &kp ESC  &kp DELETE     &kp N           &kp M  &kp COMMA
&kp DOT                &my_mt RIGHT_SHIFT SLASH  &kp LALT  &kp LGUI  &my_lt 1 SPACE  &kp TAB  &kp BACKSPACE  &my_lt 3 SPACE  &to 2  &kp RCTRL
            >;
        };

        layer_1 {
            bindings = <
&kp N1     &kp N2        &kp N3         &kp N4      &kp N5  &kp N6     &kp N7      &kp N8     &kp N9    &kp N0
&kp LCTRL  &kp CAPSLOCK  &kp LA(GRAVE)  &kp INSERT  &none   &kp MINUS  &kp EQUAL   &kp LBKT   &kp RBKT  &kp ENTER
&kp LSHFT  &none         &none          &none       &none   &kp ESC    &kp DELETE  &kp GRAVE  &kp SEMI  &kp APOS
&kp BSLH   &kp RSHFT     &kp LALT       &kp LGUI    &trans  &kp TAB    &kp BSPC    &kp SPACE  &none     &kp RCTRL
            >;
        };

        layer_2 {
            bindings = <
&kp F1     &kp F2       &kp F3         &kp F4          &kp F5           &kp F6          &kp F7          &kp F8        &kp F9           &kp F10
&kp LCTRL  &kp HOME     &kp END        &kp F11         &kp F12          &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT_ARROW  &kp ENTER
&kp LSHFT  &kp PAGE_UP  &kp PAGE_DOWN  &kp SCROLLLOCK  &kp PRINTSCREEN  &kp ESCAPE      &mkp MB4        &mkp MB1      &mkp MB3         &mkp MB2
&mkp MB5   &kp RSHFT    &kp LALT       &kp LGUI        &kp SPACE        &kp TAB         &kp LC(A)       &kp SPACE     &to 0            &kp RCTRL
            >;
        };

        layer_3 {
            bindings = <
&kp C_MUTE      &kp C_VOLUME_DOWN  &kp C_VOLUME_UP   &kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3    &bt BT_SEL 4
&none           &none              &kp PAUSE_BREAK   &kp C_STOP_EJECT      &none                 &none         &none         &none         &none           &none
&kp LEFT_SHIFT  &kp C_PREVIOUS     &kp C_PLAY_PAUSE  &kp C_NEXT            &none                 &none         &none         &bootloader   &studio_unlock  &none
&bt BT_CLR_ALL  &bt BT_CLR         &none             &none                 &none                 &none         &none         &trans        &none           &none
            >;
        };
    };
};
